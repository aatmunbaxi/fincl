;;;; viz/viz.lisp --- matplotlib plots of fincl simulations, for the REPL
;;;;
;;;; A developer aid, not part of fincl. It reaches into fincl internals
;;;; (FINCL::SIMULATE-PATHS, FINCL::MAKE-CHUNK-SOURCE, ...) so that what is
;;;; plotted is generated by the same code the pricer runs.
;;;;
;;;;   (ql:quickload :fincl-viz)
;;;;   (in-package :fincl-viz)
;;;;   (defparameter *mkt* (make-bs-market :valuation-date (make-date 2026 9 24)
;;;;                                       :spot 100 :rate 0.05d0 :vol 0.2d0))
;;;;   (plot-paths (make-instance 'garch) *mkt*)
;;;;   (plot-log-returns (make-instance 'garch :alpha 0.15d0) *mkt*)
;;;;   (plot-terminal (make-instance 'heston :rho -0.8d0) *mkt* :n-steps 50)
;;;;
;;;; Each PLOT-* function saves a PNG under *OUTPUT-DIRECTORY* and returns
;;;; its pathname. Open the file in Emacs with AUTO-REVERT-MODE on and it
;;;; redraws each time you re-run the plot.

(defpackage #:fincl-viz
  (:use #:cl #:fincl)
  (:export #:*display* #:*output-directory*
           #:simulate #:state-component #:engine-paths #:instantaneous-vol
           #:plot-paths #:plot-engine-paths #:plot-terminal
           #:plot-log-returns #:plot-convergence #:close-all
           #:plot-series #:plot-panels))

(in-package #:fincl-viz)

(setf py4cl:*python-command* "python3")

(defvar *display* :file
  ":FILE saves each figure as a PNG under *OUTPUT-DIRECTORY*. :WINDOW calls
plt.show(), which blocks the REPL until the window is closed and requires a
GUI matplotlib backend.")

(defvar *output-directory* #p"/tmp/fincl-viz/")

;;; --------------------------------------------------------------------
;;; matplotlib plumbing
;;; --------------------------------------------------------------------

(defun plt (function &rest args)
  "Call matplotlib.pyplot.FUNCTION with ARGS and discard the result.
Keyword arguments become Python keyword arguments.

  (plt \"plot\" #(0 1 2) #(1 4 9) :color \"red\")"
  ;; Discarding the result on the Python side avoids converting artists
  ;; such as Line2D, which py4cl cannot represent.
  (apply #'py4cl:python-call (format nil "_quiet(plt.~A)" function) args)
  nil)

(defun ensure-python ()
  "Signal an error unless *PYTHON-COMMAND* can import numpy and matplotlib.
Without this, a missing interpreter surfaces as END-OF-FILE on py4cl's
stream."
  (unless (py4cl:python-alive-p)
    (multiple-value-bind (output error-output status)
        (uiop:run-program (list "sh" "-c"
                                (format nil "exec ~A -c 'import numpy, matplotlib'"
                                        py4cl:*python-command*))
                          :ignore-error-status t :error-output :string)
      (declare (ignore output))
      (unless (zerop status)
        (error "~A cannot import numpy and matplotlib from this Lisp's PATH.
Start the Lisp from the fincl dev shell (nix develop, or direnv reload).~%~A"
               py4cl:*python-command* error-output)))))

(defun begin-figure (&key (size '(10 6)))
  (ensure-python)
  (py4cl:python-exec "import numpy as np
import matplotlib.pyplot as plt
def _quiet(f):
    def call(*args, **kwargs):
        f(*args, **kwargs)
    return call")
  (plt "figure" :figsize size))

(defun finish-figure (name &key title xlabel ylabel legend)
  "Label the current axes and emit the figure according to *DISPLAY*.
Returns the PNG pathname for :FILE, NIL for :WINDOW."
  (when title (plt "suptitle" title))
  (when xlabel (plt "xlabel" xlabel))
  (when ylabel (plt "ylabel" ylabel))
  (when legend (plt "legend"))
  (ecase *display*
    (:file
     (let ((path (merge-pathnames (make-pathname :name name :type "png")
                                  *output-directory*)))
       (ensure-directories-exist path)
       (plt "savefig" (namestring path) :dpi 120 :bbox_inches "tight")
       (plt "close")
       path))
    (:window
     (plt "show")
     nil)))

(defun close-all ()
  "Close every open matplotlib figure."
  (plt "close" "all"))

;;; --------------------------------------------------------------------
;;; Generic line plots, for any Lisp data
;;; --------------------------------------------------------------------

(defun draw-series (xs series)
  "Draw SERIES on the current axes: each element is (label ys) or
(label ys :style plist), YS a list or vector as long as XS."
  (dolist (s series)
    (destructuring-bind (label ys &key style) s
      (apply #'plt "plot" (coerce xs 'list) (coerce ys 'list) :label label style))))

(defun plot-series (name xs series &key title xlabel ylabel)
  "One chart of SERIES against XS (see DRAW-SERIES), saved as NAME.png.

  (plot-series "prices" spots `(("call" ,calls) ("put" ,puts)) :xlabel "spot")"
  (begin-figure)
  (draw-series xs series)
  (finish-figure name :title title :xlabel xlabel :ylabel ylabel :legend t))

(defun plot-panels (name panels &key title (columns 2))
  "A grid of charts saved as NAME.png. Each of PANELS is a plist (:xs xs
:series series :title title :xlabel x :ylabel y), SERIES as in DRAW-SERIES.

  (plot-panels "greeks" `((:xs ,spots :series (("delta" ,deltas)) :title "Delta")
                          (:xs ,spots :series (("gamma" ,gammas)) :title "Gamma")))"
  (let ((rows (ceiling (length panels) columns)))
    (begin-figure :size (list (* 6 columns) (* 4 rows)))
    (let ((i 0))
      (dolist (panel panels)
        (destructuring-bind (&key xs series title xlabel ylabel) panel
          (plt "subplot" rows columns (incf i))
          (draw-series xs series)
          (when title (plt "title" title))
          (when xlabel (plt "xlabel" xlabel))
          (when ylabel (plt "ylabel" ylabel))
          (plt "grid" :alpha 0.3)
          (when (rest series) (plt "legend" :fontsize 8)))))
    ;; Leave the top strip for the figure's title.
    (when title (plt "suptitle" title :fontsize 13))
    (plt "tight_layout" :rect '(0 0 1 0.95))
    (finish-figure name)))

;;; --------------------------------------------------------------------
;;; Simulation
;;; --------------------------------------------------------------------

(defun default-n-steps (process horizon)
  "GARCH's time step is part of the model, so its grid is fixed by PERIOD."
  (if (typep process 'garch)
      (max 1 (round horizon (fincl::period process)))
      100))

(defun time-grid (horizon n-steps)
  (let ((v (make-array (1+ n-steps) :element-type 'double-float)))
    (dotimes (j (1+ n-steps) v)
      (setf (aref v j) (* j (/ horizon n-steps))))))

(defun run-paths (process market horizon n-steps n-paths seed rng fn)
  "Step N-PATHS paths of PROCESS over [0, HORIZON] and call FN with
(path-index step-index state) at every grid point, step 0 included. STATE
is reused between calls; copy anything FN keeps. Normals come from the
generator the Monte Carlo engine uses (for a stream RNG, its first chunk's)."
  (let* ((horizon (float horizon 1d0))
         (process (fincl::resolve-process process market horizon))
         (engine (make-instance 'monte-carlo-engine
                                :process process :seed seed :rng rng))
         (stepper (make-stepper process market (fincl::uniform-time-grid horizon n-steps)))
         (template (initial-state process market))
         (state (copy-seq template))
         (normals (make-array (process-factors process)
                              :element-type 'double-float)))
    (multiple-value-bind (source start-path) (fincl::make-normal-filler engine 0)
      (dotimes (i n-paths)
        (funcall start-path i)
        (replace state template)
        (funcall fn i 0 state)
        (loop for j from 1 to n-steps
              do (fincl::fill-normals source normals)
                 (funcall stepper state normals (1- j))
                 (funcall fn i j state))))))

(defun simulate (process market &key (horizon 1) n-steps (n-paths 20)
                                     (seed 42) (rng :counter))
  "Return (values times states). TIMES has N-STEPS+1 entries. STATES is an
(N-STEPS+1) x N-PATHS x state-size array holding the full state vector,
latent components included: element 0 is the observable, element 1 is the
variance for HESTON and GARCH.

  (simulate (make-instance 'heston) mkt :n-paths 5 :n-steps 250)"
  (let* ((horizon (float horizon 1d0))
         (n-steps (or n-steps (default-n-steps process horizon)))
         (size (process-state-size process))
         (states (make-array (list (1+ n-steps) n-paths size)
                             :element-type 'double-float)))
    (run-paths process market horizon n-steps n-paths seed rng
               (lambda (i j state)
                 (dotimes (k size)
                   (setf (aref states j i k) (aref state k)))))
    (values (time-grid horizon n-steps) states)))

(defun state-component (states k)
  "The (N-STEPS+1) x N-PATHS slice of STATES for state element K."
  (destructuring-bind (rows cols size) (array-dimensions states)
    (assert (< k size) () "State has ~D components; asked for ~D." size k)
    (let ((out (make-array (list rows cols) :element-type 'double-float)))
      (dotimes (j rows out)
        (dotimes (i cols)
          (setf (aref out j i) (aref states j i k)))))))

(defun engine-paths (engine market &key (horizon 1))
  "Return (values times paths) where PATHS is the (N-STEPS+1) x N-PATHS
observable matrix exactly as ENGINE generates it for pricing, including
antithetic partners in the second half of the columns.

  (engine-paths (make-instance 'monte-carlo-engine :n-paths 20) mkt)"
  (let* ((matrix (fincl::simulate-paths engine market (float horizon 1d0)))
         (n-paths (fincl::path-matrix-n-paths matrix))
         (n-cols (fincl::path-matrix-n-times matrix))
         (data (fincl::path-matrix-data matrix))
         (out (make-array (list n-cols n-paths) :element-type 'double-float)))
    ;; Column-major: element (path i, time j) is at i + j n-paths.
    (dotimes (j n-cols)
      (dotimes (i n-paths)
        (setf (aref out j i) (aref data (+ i (* j n-paths))))))
    (values (time-grid (float horizon 1d0) (1- n-cols)) out)))

(defgeneric instantaneous-vol (process state dt)
  (:documentation "Annualized volatility implied by STATE, or NIL if the
process has no latent volatility.")
  (:method (process state dt)
    (declare (ignore process state dt))
    nil)
  (:method ((p heston) state dt)
    (declare (ignore dt))
    (sqrt (max 0d0 (aref state 1))))
  (:method ((p garch) state dt)
    ;; h is variance per model period, and dt equals the period.
    (sqrt (/ (aref state 1) dt))))

;;; --------------------------------------------------------------------
;;; Helpers
;;; --------------------------------------------------------------------

(defun row-means (matrix)
  (destructuring-bind (rows cols) (array-dimensions matrix)
    (let ((v (make-array rows :element-type 'double-float)))
      (dotimes (j rows v)
        (setf (aref v j)
              (/ (loop for i below cols sum (aref matrix j i)) cols))))))

(defun first-columns (matrix count)
  (destructuring-bind (rows cols) (array-dimensions matrix)
    (let* ((count (min count cols))
           (out (make-array (list rows count) :element-type 'double-float)))
      (dotimes (j rows out)
        (dotimes (i count)
          (setf (aref out j i) (aref matrix j i)))))))

(defun forward-curve (market times)
  (map '(vector double-float) (lambda (tt) (forward market tt)) times))

(defun process-name (process)
  (string-downcase (class-name (class-of process))))

;;; --------------------------------------------------------------------
;;; Plots
;;; --------------------------------------------------------------------

(defun plot-paths (process market &key (horizon 1) n-steps (n-paths 20)
                                       (seed 42) (rng :counter)
                                       (component 0) (name "paths") title)
  "Plot state element COMPONENT of N-PATHS simulated paths with their
sample mean. For the observable (COMPONENT 0) the market forward is drawn
as well; under the risk-neutral measure the mean should track it.

  (plot-paths (make-instance 'garch) mkt)
  (plot-paths (make-instance 'heston) mkt :component 1)   ; variance"
  (multiple-value-bind (times states)
      (simulate process market :horizon horizon :n-steps n-steps
                               :n-paths n-paths :seed seed :rng rng)
    (let ((ys (state-component states component)))
      (begin-figure)
      (plt "plot" times ys :linewidth 0.8 :alpha 0.6)
      (plt "plot" times (row-means ys)
           :color "black" :linewidth 2 :label "sample mean")
      (when (zerop component)
        (plt "plot" times (forward-curve market times)
             :color "red" :linestyle "--" :label "forward"))
      (finish-figure name
                     :title (or title (format nil "~A: ~D paths"
                                              (process-name process) n-paths))
                     :xlabel "t (years)"
                     :ylabel (if (zerop component)
                                 "S"
                                 (format nil "state[~D]" component))
                     :legend t))))

(defun plot-engine-paths (engine market &key (horizon 1) (max-paths 200)
                                             (name "engine-paths") title)
  "Plot up to MAX-PATHS of the observable paths ENGINE generates for
pricing. Build the engine with a small :N-PATHS; with :ANTITHETIC T the
second half of the paths mirrors the first.

  (plot-engine-paths (make-instance 'monte-carlo-engine
                                    :process (make-instance 'garch)
                                    :n-paths 20 :n-steps 252)
                     mkt)"
  (multiple-value-bind (times paths) (engine-paths engine market :horizon horizon)
    (begin-figure)
    (plt "plot" times (first-columns paths max-paths) :linewidth 0.8 :alpha 0.6)
    (plt "plot" times (forward-curve market times)
         :color "red" :linestyle "--" :label "forward")
    (finish-figure name
                   :title (or title (format nil "~A engine paths"
                                            (process-name (process engine))))
                   :xlabel "t (years)" :ylabel "S" :legend t)))

(defun lognormal-density (x forward vol horizon)
  (let ((s (* vol (sqrt horizon))))
    (/ (exp (- (/ (expt (+ (log (/ x forward)) (* 0.5d0 s s)) 2)
                  (* 2d0 s s))))
       (* x s (sqrt (* 2d0 pi))))))

(defun plot-terminal (process market &key (horizon 1) n-steps (n-paths 20000)
                                          (seed 42) (rng :counter)
                                          (bins 100) (name "terminal") title)
  "Histogram of the observable at HORIZON against the lognormal density
with the market's Black vol. Skew or fat tails relative to the curve show
what the process adds beyond GBM. Returns (values pathname sample-mean
forward); the two means should agree within Monte Carlo error.

  (plot-terminal (make-instance 'heston :rho -0.8d0 :xi 0.6d0) mkt)"
  (let* ((horizon (float horizon 1d0))
         (n-steps (or n-steps (default-n-steps process horizon)))
         (xs (make-array n-paths :element-type 'double-float)))
    (run-paths process market horizon n-steps n-paths seed rng
               (lambda (i j state)
                 (when (= j n-steps)
                   (setf (aref xs i) (aref state 0)))))
    (let* ((fwd (forward market horizon))
           (vol (black-vol market (spot market) horizon))
           (lo (reduce #'min xs))
           (hi (reduce #'max xs))
           (grid (let ((v (make-array 400 :element-type 'double-float)))
                   (dotimes (k 400 v)
                     (setf (aref v k) (+ lo (* k (/ (- hi lo) 399)))))))
           (density (map '(vector double-float)
                         (lambda (x) (lognormal-density x fwd vol horizon))
                         grid)))
      (begin-figure)
      (plt "hist" xs :bins bins :density t :alpha 0.5 :label "simulated")
      (plt "plot" grid density :color "red"
           :label (format nil "lognormal, vol ~,3F" vol))
      (plt "axvline" fwd :color "black" :linestyle ":" :label "forward")
      (values (finish-figure name
                             :title (or title (format nil "~A: S(~,2F), ~D paths"
                                                      (process-name process)
                                                      horizon n-paths))
                             :xlabel "S" :ylabel "density" :legend t)
              (/ (reduce #'+ xs) n-paths)
              fwd))))

(defun plot-log-returns (process market &key (horizon 1) n-steps (seed 42)
                                             (rng :counter)
                                             (name "returns") title)
  "Plot the per-step log returns of one path above its annualized
|return|/sqrt(dt) and, for HESTON and GARCH, the instantaneous volatility.
Volatility clustering shows up as bursts in the returns that line up with
peaks in the volatility.

  (plot-log-returns (make-instance 'garch :alpha 0.15d0 :beta 0.8d0) mkt)"
  (let* ((horizon (float horizon 1d0))
         (n-steps (or n-steps (default-n-steps process horizon)))
         (dt (/ horizon n-steps))
         (spots (make-array (1+ n-steps) :element-type 'double-float))
         (vols (make-array (1+ n-steps) :initial-element nil)))
    (run-paths process market horizon n-steps 1 seed rng
               (lambda (i j state)
                 (declare (ignore i))
                 (setf (aref spots j) (aref state 0)
                       (aref vols j) (instantaneous-vol process state dt))))
    (let* ((times (time-grid horizon n-steps))
           (step-times (subseq times 1))
           (returns (make-array n-steps :element-type 'double-float)))
      (dotimes (j n-steps)
        (setf (aref returns j) (log (/ (aref spots (1+ j)) (aref spots j)))))
      (begin-figure :size '(10 8))
      (plt "subplot" 2 1 1)
      (plt "plot" step-times returns :linewidth 0.7)
      (plt "ylabel" "log return")
      (plt "subplot" 2 1 2)
      (plt "plot" step-times
           (map '(vector double-float) (lambda (r) (/ (abs r) (sqrt dt))) returns)
           :color "gray" :linewidth 0.6 :alpha 0.7 :label "|r| / sqrt(dt)")
      (when (aref vols 0)
        (plt "plot" times (coerce vols '(vector double-float))
             :color "red" :linewidth 1.5 :label "instantaneous vol"))
      (finish-figure name
                     :title (or title (format nil "~A: one path, ~D steps"
                                              (process-name process) n-steps))
                     :xlabel "t (years)" :ylabel "annualized vol" :legend t))))

(defun plot-convergence (option market &key (process (make-instance 'gbm))
                                            (path-counts '(1000 4000 16000 64000 256000))
                                            (n-steps 50) (seed 42) reference
                                            (name "convergence") title)
  "Price OPTION with a Monte Carlo engine at each of PATH-COUNTS and plot
the estimates with 2-standard-error bars against REFERENCE, if given.
Returns (values pathname results) where RESULTS is a list of
(n-paths price standard-error).

  (plot-convergence (option (call 100) (expires (make-date 2027 9 24))) mkt
                    :reference (price (option (call 100) (expires (make-date 2027 9 24)))
                                      (make-instance 'black-scholes-engine) mkt))"
  (let ((results
          (loop for n in path-counts
                collect (multiple-value-bind (v se)
                            (price option (make-instance 'monte-carlo-engine
                                                         :process process
                                                         :n-paths n
                                                         :n-steps n-steps
                                                         :seed seed)
                                   market)
                          (list n v se)))))
    (begin-figure)
    (plt "errorbar" (mapcar #'first results) (mapcar #'second results)
         :yerr (mapcar (lambda (r) (* 2 (third r))) results)
         :fmt "o-" :capsize 3 :label "MC, 2 SE")
    (plt "xscale" "log")
    (when reference
      (plt "axhline" reference :color "red" :linestyle "--" :label "reference"))
    (values (finish-figure name
                           :title (or title (format nil "~A under ~A"
                                                    option (process-name process)))
                           :xlabel "paths" :ylabel "price" :legend t)
            results)))
