;;;; analytic.lisp --- closed forms and approximations

(in-package #:fincl/tests)
(named-readtables:in-readtable fincl:syntax)

(defun analytic-checks ()
  "Black-Scholes and Barone-Adesi-Whaley against known values."
  (with-standard-fixtures
    (format t "~&Analytic~%")
    (check "BS call" 10.4506 (price call bs mkt) 1d-4)
    (check "BS put" 5.5735 (price put bs mkt) 1d-4)
    (check "put-call parity" (- 100 (* 100 (exp -0.05d0)))
           (- (price call bs mkt) (price put bs mkt)) 1d-12)
    (check "BAW American put" 4.46 (price aput baw mkt2) 0.02)
    ;; Any market with deterministic rates, not only the flat one.
    (let ((pm (make-piecewise-market)))
      (dolist (kind '(:call :put))
        (check (format nil "BS ~(~A~) on a piecewise market = Black with integrated D, F, w" kind)
               (fincl::black-formula (if (eq kind :call) 1d0 -1d0) (forward pm 1d0) 100d0
                                     (discount-factor pm 1d0) (black-variance pm 100d0 1d0))
               (price (make-option-from-clauses `((,kind 100) (:expires #D"2027-09-24"))) bs pm)
               1d-14))
      (check-that "BAW prices an American put on a piecewise market"
                  (let ((v (price (make-option (put 110) (american) (expires #D"2027-09-24")) baw pm)))
                    (and (realp v)
                         (>= v (price (make-option (put 110) (expires #D"2027-09-24")) bs pm)))))))
  (baw-rate-regime-checks))

(defun rate-market (r q)
  (make-bs-market :valuation-date *today* :spot 100 :rate r :dividend q :vol 0.25d0))

(defun baw-rate-regime-checks ()
  "BAW at zero and negative rates, against Black-Scholes and BBSR binomial."
  (format t "~&BAW at zero and negative rates~%")
  (let ((baw (make-instance 'barone-adesi-whaley-engine))
        (bs (make-instance 'black-scholes-engine))
        (tree (binomial 2000))
        (d #D"2027-09-24"))
    (flet ((american (kind) (make-option-from-clauses `((,kind 100) (:american) (:expires ,d))))
           (european (kind) (make-option-from-clauses `((,kind 100) (:expires ,d)))))
      (iter (for (r q) in '((0 0.02d0) (-0.005d0 0) (-0.01d0 -0.005d0)))
            (check (format nil "American put at r = ~A, q = ~A = European (q >= r)" r q)
                   (price (european :put) bs (rate-market r q))
                   (price (american :put) baw (rate-market r q))
                   1d-12))
      (iter (for (r q) in '((0.01d0 -0.02d0) (-0.005d0 -0.02d0)))
            (check (format nil "American call at r = ~A, q = ~A = European (r >= q)" r q)
                   (price (european :call) bs (rate-market r q))
                   (price (american :call) baw (rate-market r q))
                   1d-12))
      (iter (for (r q) in '((0 0.02d0) (-0.005d0 0) (-0.01d0 0.03d0)))
            (let ((m (rate-market r q)))
              (check-that (format nil "American call at r = ~A, q = ~A: finite, above the ~
                                       European, within 0.05 of BBSR" r q)
                          (let ((v (price (american :call) baw m)))
                            (and (realp v)
                                 (> v (price (european :call) bs m))
                                 (< (abs (- v (price (american :call) tree m))) 0.05d0))))))
      (dolist (kind '(:call :put))
        (dolist (q '(0 0.02d0))
          (check (format nil "BAW ~(~A~), q = ~A: continuous at r = 0" kind q)
                 (price (american kind) baw (rate-market 0 q))
                 (price (american kind) baw (rate-market 1d-12 q))
                 1d-8)))
      ;; Two exercise boundaries: BAW refuses; the tree shows the premium.
      (iter (for (kind r q) in '((:put -0.005d0 -0.02d0) (:call -0.02d0 -0.005d0)))
            (let ((m (rate-market r q)))
              (check-error (format nil "BAW ~(~A~) at r = ~A, q = ~A (two boundaries)" kind r q)
                           (price (american kind) baw m)
                           model-domain-error)
              (check-that (format nil "the tree prices that ~(~A~) above the European" kind)
                          (> (price (american kind) tree m)
                             (+ (price (european kind) bs m) 0.01d0))))))))
