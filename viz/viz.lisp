;;;; viz/viz.lisp --- Plotly figures of fincl simulations, for the REPL
;;;;
;;;; A developer aid, not part of fincl. It reaches into fincl internals
;;;; (FINCL::SIMULATE-PATHS, FINCL::MAKE-NORMAL-FILLER, ...) so that what is
;;;; plotted is generated by the same code the pricer runs.
;;;;
;;;;   (ql:quickload :fincl-viz)
;;;;   (in-package :fincl-viz)
;;;;   (defparameter *mkt* (make-bs-market :valuation-date (make-date 2026 9 24)
;;;;                                       :spot 100 :rate 0.05d0 :vol 0.2d0))
;;;;   (plot-paths (make-garch) *mkt*)
;;;;   (plot-log-returns (make-garch :alpha 0.15d0) *mkt*)
;;;;   (plot-terminal (make-heston :rho -0.8d0) *mkt* :n-steps 50)
;;;;   (plot-paths (make-heston) *mkt* :layout '(:yaxis (:type "log"))
;;;;               :style '(("forward" :line (:color "green"))) :display :html)
;;;;
;;;; Each figure is Lisp data: a plist (:data traces :layout plist :config
;;;; plist) of Plotly attributes (viz/json.lisp gives the JSON mapping). Every
;;;; plot is a DEFINE-PLOT: NAME-FIGURE returns the figure and PLOT-NAME writes
;;;; NAME.json under *OUTPUT-DIRECTORY* and, by *DISPLAY* (default :PNG), an
;;;; image, HTML or a browser window, returning the file's pathname. Open a PNG
;;;; in Emacs with AUTO-REVERT-MODE on and it redraws each time you re-run the
;;;; plot. Every PLOT- function takes :LAYOUT, :CONFIG, :STYLE, :TITLE, :NAME
;;;; and :DISPLAY (see DEFINE-PLOT); *THEME* holds the shared presentation.
;;;;
;;;; The JSON is a plain Plotly figure; viz/render.py renders it on its own:
;;;;
;;;;   python3 viz/render.py /tmp/fincl-viz/paths.json -o paths.svg
;;;;   python3 viz/render.py /tmp/fincl-viz/paths.json       # a browser
;;;;
;;;; A new plot is a DEFINE-PLOT built from the exported trace builders,
;;;; PANEL and PANEL-GRID; PLOT-CALL-PRICE-SURFACE in greeks.lisp is one.

(in-package #:fincl-viz)

;;; --------------------------------------------------------------------
;;; Generic plots, for any Lisp data
;;; --------------------------------------------------------------------

(defun series-traces (xs series)
  "A line per element of SERIES against XS: each element is (label ys) or
(label ys :style plist), YS as long as XS and STYLE Plotly trace attributes."
  (mapcar (lambda (s)
            (destructuring-bind (label ys &key style) s
              (line-trace xs ys :name label :style style)))
          series))

(defun series-panel (spec)
  "The panel of SPEC, a plist (:xs xs :series series :title s :xlabel s
:ylabel s), SERIES as in SERIES-TRACES; a lone series has no legend entry."
  (destructuring-bind (&key xs series title xlabel ylabel) spec
    (panel (if (rest series)
               (series-traces xs series)
               (mapcar (lambda (trace) (merge-spec trace '(:showlegend nil)))
                       (series-traces xs series)))
           :title title :xlabel xlabel :ylabel ylabel)))

(define-plot series (xs series &key xlabel ylabel)
  "SERIES (see SERIES-TRACES) against XS on one pair of axes.

  (plot-series spots `((\"call\" ,calls) (\"put\" ,puts)) :xlabel \"spot\" :name \"prices\")"
  (panel-grid (list (panel (series-traces xs series) :xlabel xlabel :ylabel ylabel))))

(define-plot array (data &key (kind :line) xs xlabel ylabel label)
  "A one-dimensional array DATA drawn as a :LINE, :SCATTER (dots) or :BAR
chart. XS gives the horizontal positions; by default they are the indices
0 .. n-1.

  (plot-array (random-uniforms 500) :kind :scatter :xlabel \"draw\" :ylabel \"U(0, 1)\"
              :name \"uniform-dots\")"
  (check-input kind (member :line :scatter :bar))
  (let ((xs (or xs (a:iota (length data)))))
    (panel-grid
     (list (panel (list (ecase kind
                          (:line (line-trace xs data :name label :style '(:line (:width 1))))
                          (:scatter (scatter-trace xs data :name label))
                          (:bar (bar-trace xs data :name label))))
                  :xlabel xlabel :ylabel ylabel)))))

(defun random-uniforms (n)
  "N independent uniform draws on (0, 1], as a vector; a plain Lisp source for
the examples, not fincl's generator."
  (let ((draws (make-array n)))
    (dotimes (i n draws)
      (setf (aref draws i) (- 1d0 (random 1d0))))))

(define-plot panels (specs &key (columns 2))
  "A grid of charts, one per element of SPECS, a plist (:xs xs :series series
:title title :xlabel x :ylabel y) as SERIES-PANEL reads it.

  (plot-panels `((:xs ,spots :series ((\"delta\" ,deltas)) :title \"Delta\")
                 (:xs ,spots :series ((\"gamma\" ,gammas)) :title \"Gamma\"))
               :name \"greeks\")"
  (panel-grid (mapcar #'series-panel specs) :columns columns))

;;; --------------------------------------------------------------------
;;; Simulation
;;; --------------------------------------------------------------------

(defun default-n-steps (process horizon)
  "GARCH's time step is part of the model, so its grid is fixed by PERIOD."
  (if (typep process 'garch)
      (max 1 (round horizon (fincl::period process)))
      100))

(defun time-grid (horizon n-steps)
  (let ((v (make-array (1+ n-steps) :element-type 'double-float)))
    (dotimes (j (1+ n-steps) v)
      (setf (aref v j) (* j (/ horizon n-steps))))))

(defun run-paths (process market horizon n-steps n-paths seed rng fn)
  "Step N-PATHS paths of PROCESS over [0, HORIZON] and call FN with
(path-index step-index state) at every grid point, step 0 included. STATE
is reused between calls; copy anything FN keeps. Normals come from the
generator the Monte Carlo engine uses (for a stream RNG, its first chunk's)."
  (let* ((horizon (float horizon 1d0))
         (process (fincl::resolve-process process market horizon))
         (engine (make-instance 'monte-carlo-engine
                                :process process :seed seed :rng rng))
         (stepper (make-stepper process market (fincl::uniform-time-grid horizon n-steps)))
         (template (initial-state process market))
         (state (copy-seq template))
         (normals (make-array (process-factors process)
                              :element-type 'double-float)))
    (multiple-value-bind (source start-path) (fincl::make-normal-filler engine 0)
      (dotimes (i n-paths)
        (funcall start-path i)
        (replace state template)
        (funcall fn i 0 state)
        (loop for j from 1 to n-steps
              do (fincl::fill-normals source normals)
                 (funcall stepper state normals (1- j))
                 (funcall fn i j state))))))

(defun simulate (process market &key (horizon 1) n-steps (n-paths 20)
                                     (seed 42) (rng :counter))
  "Return (values times states). TIMES has N-STEPS+1 entries. STATES is an
(N-STEPS+1) x N-PATHS x state-size array holding the full state vector,
latent components included: element 0 is the observable, element 1 is the
variance for HESTON and GARCH.

  (simulate (make-instance 'heston) mkt :n-paths 5 :n-steps 250)"
  (let* ((horizon (float horizon 1d0))
         (n-steps (or n-steps (default-n-steps process horizon)))
         (size (process-state-size process))
         (states (make-array (list (1+ n-steps) n-paths size)
                             :element-type 'double-float)))
    (run-paths process market horizon n-steps n-paths seed rng
               (lambda (i j state)
                 (dotimes (k size)
                   (setf (aref states j i k) (aref state k)))))
    (values (time-grid horizon n-steps) states)))

(defun state-component (states k)
  "The (N-STEPS+1) x N-PATHS slice of STATES for state element K."
  (destructuring-bind (rows cols size) (array-dimensions states)
    (assert (< k size) () "State has ~D components; asked for ~D." size k)
    (let ((out (make-array (list rows cols) :element-type 'double-float)))
      (dotimes (j rows out)
        (dotimes (i cols)
          (setf (aref out j i) (aref states j i k)))))))

(defun engine-paths (engine market &key (horizon 1))
  "Return (values times paths) where PATHS is the (N-STEPS+1) x N-PATHS
observable matrix exactly as ENGINE generates it for pricing, including
antithetic partners in the second half of the columns.

  (engine-paths (make-instance 'monte-carlo-engine :n-paths 20) mkt)"
  (let* ((matrix (fincl::simulate-paths engine market (float horizon 1d0)))
         (n-paths (fincl::path-matrix-n-paths matrix))
         (n-cols (fincl::path-matrix-n-times matrix))
         (data (fincl::path-matrix-data matrix))
         (out (make-array (list n-cols n-paths) :element-type 'double-float)))
    ;; Column-major: element (path i, time j) is at i + j n-paths.
    (dotimes (j n-cols)
      (dotimes (i n-paths)
        (setf (aref out j i) (aref data (+ i (* j n-paths))))))
    (values (time-grid (float horizon 1d0) (1- n-cols)) out)))

(defgeneric instantaneous-vol (process state dt)
  (:documentation "Annualized volatility implied by STATE, or NIL if the
process has no latent volatility.")
  (:method (process state dt)
    (declare (ignore process state dt))
    nil)
  (:method ((p heston) state dt)
    (declare (ignore dt))
    (sqrt (max 0d0 (aref state 1))))
  (:method ((p garch) state dt)
    ;; h is variance per model period, and dt equals the period.
    (sqrt (/ (aref state 1) dt))))

;;; --------------------------------------------------------------------
;;; Helpers
;;; --------------------------------------------------------------------

(defun row-means (matrix)
  (destructuring-bind (rows cols) (array-dimensions matrix)
    (let ((v (make-array rows :element-type 'double-float)))
      (dotimes (j rows v)
        (setf (aref v j)
              (/ (loop for i below cols sum (aref matrix j i)) cols))))))

(defun first-columns (matrix count)
  (destructuring-bind (rows cols) (array-dimensions matrix)
    (let* ((count (min count cols))
           (out (make-array (list rows count) :element-type 'double-float)))
      (dotimes (j rows out)
        (dotimes (i count)
          (setf (aref out j i) (aref matrix j i)))))))

(defun forward-curve (market times)
  (map '(vector double-float) (lambda (tt) (forward market tt)) times))

(defun process-name (process)
  (string-downcase (class-name (class-of process))))

(define-process uniform-draws (stochastic-process) ()
  ()
  (:documentation "A process whose observable is an independent uniform draw on
(0, 1) at every step, made from the step's normal by the normal CDF. Its only
purpose is to show a stepper's paths in the plots."))

(defmethod initial-state ((p uniform-draws) market)
  (declare (ignore market))
  (make-array 1 :element-type 'double-float :initial-element 0.5d0))

(defmethod make-stepper ((p uniform-draws) market times)
  (declare (ignore market times))
  (lambda (state normals j)
    (declare (type (simple-array double-float (*)) state normals) (ignore j))
    (setf (aref state 0) (norm-cdf (aref normals 0)))
    nil))

;;; --------------------------------------------------------------------
;;; Plots
;;; --------------------------------------------------------------------

(defun path-dots (times ys)
  "One trace of dots for every column of the (N-STEPS+1) x N-PATHS matrix YS
at TIMES."
  (destructuring-bind (rows cols) (array-dimensions ys)
    (iter (for i below cols)
          (dotimes (j rows)
            (collect (aref times j) into xs result-type vector)
            (collect (aref ys j i) into vs result-type vector))
          (finally (return (scatter-trace xs vs :style '(:opacity 0.5)))))))

(defun forward-trace (market times)
  (line-trace times (forward-curve market times) :name "forward"
              :style `(:line (:color ,(theme-color :forward) :dash "dash"))))

(define-plot paths (process market &key (horizon 1) n-steps (n-paths 20)
                                        (seed 42) (rng :counter)
                                        (component 0) (kind :line) (forward t))
  "State element COMPONENT of N-PATHS simulated paths with their sample mean.
KIND is :LINE (one line per path) or :SCATTER (a dot per path and step).
FORWARD draws the market forward for the observable; under the risk-neutral
measure the mean should track it, so pass NIL for processes whose observable
is not a price.

  (plot-paths (make-garch) mkt)
  (plot-paths (make-heston) mkt :component 1)   ; variance
  (plot-paths (make-instance 'uniform-draws) mkt :kind :scatter :forward nil)"
  (check-input kind (member :line :scatter))
  (multiple-value-bind (times states)
      (simulate process market :horizon horizon :n-steps n-steps
                               :n-paths n-paths :seed seed :rng rng)
    (let ((ys (state-component states component))
          (observable (and forward (zerop component))))
      (panel-grid
       (list (panel `(,@(ecase kind
                          (:line (matrix-traces times ys :style '(:line (:width 0.8) :opacity 0.6)))
                          (:scatter `(,(path-dots times ys))))
                      ,(line-trace times (row-means ys) :name "sample mean"
                                   :style `(:line (:color ,(theme-color :mean) :width 2)))
                      ,@(when observable `(,(forward-trace market times))))
                    :xlabel "t (years)"
                    :ylabel (if observable "S" (format nil "state[~D]" component))))
       :title (format nil "~A: ~D paths" (process-name process) n-paths)))))

(define-plot engine-paths (engine market &key (horizon 1) (max-paths 200))
  "Up to MAX-PATHS of the observable paths ENGINE generates for pricing.
Build the engine with a small :N-PATHS; with :ANTITHETIC T the second half of
the paths mirrors the first.

  (plot-engine-paths (make-engine :mc :process (make-garch) :n-paths 20 :n-steps 252) mkt)"
  (multiple-value-bind (times paths) (engine-paths engine market :horizon horizon)
    (panel-grid
     (list (panel `(,@(matrix-traces times (first-columns paths max-paths)
                                     :style '(:line (:width 0.8) :opacity 0.6))
                    ,(forward-trace market times))
                  :xlabel "t (years)" :ylabel "S"))
     :title (format nil "~A engine paths" (process-name (process engine))))))

(defun lognormal-density (x forward vol horizon)
  (let ((s (* vol (sqrt horizon))))
    (/ (exp (- (/ (expt (+ (log (/ x forward)) (* 0.5d0 s s)) 2)
                  (* 2d0 s s))))
       (* x s (sqrt (* 2d0 pi))))))

(defun terminal-sample (process market horizon n-steps n-paths seed rng)
  "The observable of N-PATHS paths at HORIZON, as a double vector."
  (let ((xs (make-array n-paths :element-type 'double-float)))
    (run-paths process market horizon n-steps n-paths seed rng
               (lambda (i j state)
                 (when (= j n-steps)
                   (setf (aref xs i) (aref state 0)))))
    xs))

(define-plot terminal (process market &key (horizon 1) n-steps (n-paths 20000)
                                           (seed 42) (rng :counter) (bins 100))
  "Density histogram of the observable at HORIZON against the lognormal
density with the market's Black vol. Skew or fat tails relative to the curve
show what the process adds beyond GBM. Further values: the sample mean and
the forward, which should agree within Monte Carlo error.

  (plot-terminal (make-heston :rho -0.8d0 :xi 0.6d0) mkt)"
  (let* ((horizon (float horizon 1d0))
         (n-steps (or n-steps (default-n-steps process horizon)))
         (xs (terminal-sample process market horizon n-steps n-paths seed rng))
         (fwd (forward market horizon))
         (vol (black-vol market (spot market) horizon))
         (lo (reduce #'min xs))
         (hi (reduce #'max xs))
         (grid (iter (for k below 400)
                     (fincl::collect-double (+ lo (* k (/ (- hi lo) 399))) into g length 400)
                     (finally (return g)))))
    (multiple-value-bind (centers heights width) (histogram-density xs bins)
      (values
       (configure-figure
        (panel-grid
         (list (panel `(,(bar-trace centers heights :name "simulated"
                                    :style `(:width ,width :opacity 0.5
                                             :marker (:line (:width 0))))
                        ,(line-trace grid (map '(vector double-float)
                                               (lambda (x) (lognormal-density x fwd vol horizon))
                                               grid)
                                     :name (format nil "lognormal, vol ~,3F" vol)
                                     :style `(:line (:color ,(theme-color :reference))))
                        ,(vline fwd :name "forward"
                                    :style `(:line (:color ,(theme-color :mean) :dash "dot"))))
                      :xlabel "S" :ylabel "density"))
         :title (format nil "~A: S(~,2F), ~D paths" (process-name process) horizon n-paths))
        :layout '(:bargap 0))
       (/ (reduce #'+ xs) n-paths)
       fwd))))

(define-plot log-returns (process market &key (horizon 1) n-steps (seed 42) (rng :counter))
  "The per-step log returns of one path above its annualized |return|/sqrt(dt)
and, for HESTON and GARCH, the instantaneous volatility. Volatility
clustering shows up as bursts in the returns that line up with peaks in the
volatility.

  (plot-log-returns (make-garch :alpha 0.15d0 :beta 0.8d0) mkt)"
  (let* ((horizon (float horizon 1d0))
         (n-steps (or n-steps (default-n-steps process horizon)))
         (dt (/ horizon n-steps))
         (spots (make-array (1+ n-steps) :element-type 'double-float))
         (vols (make-array (1+ n-steps) :initial-element nil)))
    (run-paths process market horizon n-steps 1 seed rng
               (lambda (i j state)
                 (declare (ignore i))
                 (setf (aref spots j) (aref state 0)
                       (aref vols j) (instantaneous-vol process state dt))))
    (let* ((times (time-grid horizon n-steps))
           (step-times (subseq times 1))
           (returns (make-array n-steps :element-type 'double-float)))
      (dotimes (j n-steps)
        (setf (aref returns j) (log (/ (aref spots (1+ j)) (aref spots j)))))
      (panel-grid
       (list (panel (list (line-trace step-times returns :style '(:line (:width 0.7))))
                    :ylabel "log return")
             (panel `(,(line-trace step-times
                                   (map '(vector double-float) (lambda (r) (/ (abs r) (sqrt dt)))
                                        returns)
                                   :name "|r| / sqrt(dt)"
                                   :style `(:line (:color ,(theme-color :secondary) :width 0.6)
                                            :opacity 0.7))
                      ,@(when (aref vols 0)
                          `(,(line-trace times (coerce vols '(vector double-float))
                                         :name "instantaneous vol"
                                         :style `(:line (:color ,(theme-color :forward) :width 1.5))))))
                    :xlabel "t (years)" :ylabel "annualized vol"
                    :xaxis '(:matches "x")))
       :columns 1 :cell-width 1000
       :title (format nil "~A: one path, ~D steps" (process-name process) n-steps)))))

(define-plot convergence (option market &key (process (make-gbm))
                                             (path-counts '(1000 4000 16000 64000 256000))
                                             (n-steps 50) (seed 42) reference)
  "OPTION priced by Monte Carlo at each of PATH-COUNTS, with 2-standard-error
bars, against REFERENCE if given. Further value: the results, a list of
(n-paths price standard-error).

  (let ((o (make-option (call 100) (expires (make-date 2027 9 24)))))
    (plot-convergence o mkt :reference (price o :black-scholes mkt)))"
  (let ((results (mapcar (lambda (n)
                           (multiple-value-bind (v se)
                               (price option (make-engine :mc :process process :n-paths n
                                                              :n-steps n-steps :seed seed)
                                      market)
                             `(,n ,v ,se)))
                         path-counts)))
    (values
     (panel-grid
      (list (panel `(,(error-trace (mapcar #'first results) (mapcar #'second results)
                                   (mapcar (lambda (r) (* 2 (third r))) results)
                                   :name "MC, 2 SE")
                     ,@(when reference
                         `(,(hline reference :name "reference"
                                             :style `(:line (:color ,(theme-color :reference)
                                                             :dash "dash"))))))
                   :xlabel "paths" :ylabel "price" :xaxis '(:type "log")))
      :title (format nil "~A under ~A" option (process-name process)))
     results)))
