;;;; viz/viz.lisp --- Plotly figures of fincl simulations, for the REPL
;;;;
;;;; A developer aid, not part of fincl. Paths come from FINCL:SIMULATE, so
;;;; what is plotted is generated by the same code the pricer runs.
;;;;
;;;;   (ql:quickload :fincl-viz)
;;;;   (in-package :fincl-viz)
;;;;   (defparameter *mkt* (make-bs-market :valuation-date (make-date 2026 9 24)
;;;;                                       :spot 100 :rate 0.05d0 :vol 0.2d0))
;;;;   (plot-paths (make-heston) *mkt*)
;;;;   (plot-log-returns (make-heston :xi 0.8d0) *mkt*)
;;;;   (plot-terminal (make-heston :rho -0.8d0) *mkt*)
;;;;   (plot-paths (make-heston) *mkt* :layout '(:yaxis (:type "log"))
;;;;               :style '(("forward" :line (:color "green"))) :display :html)
;;;;
;;;; Each figure is Lisp data: a plist (:data traces :layout plist :config
;;;; plist) of Plotly attributes (viz/json.lisp gives the JSON mapping). Every
;;;; plot is a DEFINE-PLOT: NAME-FIGURE returns the figure and PLOT-NAME writes
;;;; NAME.json under *OUTPUT-DIRECTORY* and, by *DISPLAY* (default :PNG), an
;;;; image, HTML or a browser window, returning the file's pathname. Open a PNG
;;;; in Emacs with AUTO-REVERT-MODE on and it redraws each time you re-run the
;;;; plot. Every PLOT- function takes :LAYOUT, :CONFIG, :STYLE, :TITLE, :NAME
;;;; and :DISPLAY (see DEFINE-PLOT); *THEME* holds the shared presentation.
;;;;
;;;; The JSON is a plain Plotly figure; viz/render.py renders it on its own:
;;;;
;;;;   python3 viz/render.py /tmp/fincl-viz/paths.json -o paths.svg
;;;;   python3 viz/render.py /tmp/fincl-viz/paths.json       # a browser
;;;;

(in-package #:fincl-viz)

;;; --------------------------------------------------------------------
;;; Simulation plots, built on FINCL:SIMULATE and the layers of plot.lisp
;;; --------------------------------------------------------------------

(defun path-dates (market horizon n-dates)
  "N-DATES distinct dates after the valuation date, the last HORIZON years
(365 days to the year) away."
  (let ((today (valuation-date market))
        (days (max n-dates (round (* horizon 365)))))
    (iter (for k from 1 to n-dates)
          (collect (date+ today (round (* k days) n-dates))))))

(defun process-name (process)
  (string-downcase (class-name (class-of process))))

(defun line-layer (role xs ys name)
  "A layer of role ROLE drawing YS against the date labels XS."
  (make-layer role :time
              (lambda (style)
                `(,(line-trace xs ys :name name :style (line-attributes (funcall style)))))
              :name name))

(defun forward-layer (market dates)
  (line-layer :reference (map 'vector #'date-label dates)
              (map 'double-vector (lambda (d) (forward market d)) dates)
              "forward"))

(define-plot paths (process market &key (horizon 1) (n-dates 50) (n-paths 20)
                                        (seed 42) (rng :counter) (component :spot) (forward t))
  "State COMPONENT (a name of the process's state, :SPOT or :VARIANCE) of
N-PATHS simulated paths, at N-DATES dates over HORIZON years, with their sample
mean. FORWARD draws the market forward for the spot; under the risk-neutral
measure the mean should track it, so pass NIL for processes whose observable
is not a price. The process must be steppable between dates (not GARCH).

  (plot-paths (make-heston) mkt)
  (plot-paths (make-heston) mkt :component :variance)"
  (let* ((dates (path-dates market horizon n-dates))
         (r (simulate (process market dates :n-paths n-paths :seed seed :rng rng :keep (:paths n-paths))
              (:state s component)
              (:every (date) (record :state s)))))
    (plot-figure (apply #'panel (paths r :state component :n n-paths)
                        (mean-line r :state :label "sample mean")
                        `(,@(when (and forward (eq component :spot)) `(,(forward-layer market dates)))
                          :xlabel "date" :ylabel ,(string-downcase component)))
                 :title (format nil "~A: ~D paths" (process-name process) n-paths))))

(defun lognormal-density (x forward vol horizon)
  (let ((s (* vol (sqrt horizon))))
    (/ (exp (- (/ (expt (+ (log (/ x forward)) (* 0.5d0 s s)) 2)
                  (* 2d0 s s))))
       (* x s (sqrt (* 2d0 pi))))))

(define-plot terminal (process market &key (horizon 1) (n-paths 20000)
                                           (seed 42) (rng :counter) (bins 100))
  "Density histogram of the observable at HORIZON against the lognormal
density with the market's Black vol. Skew or fat tails relative to the curve
show what the process adds beyond GBM. Further values: the sample mean and
the forward, which should agree within Monte Carlo error.

  (plot-terminal (make-heston :rho -0.8d0 :xi 0.6d0) mkt)"
  (let* ((horizon (float horizon 1d0))
         (expiry (date+ (valuation-date market) (max 1 (round (* horizon 365)))))
         (tau (market-time market expiry))
         (r (simulate (process market (list expiry) :n-paths n-paths :seed seed :rng rng)
              (:state s :spot)
              (:final (:spot s))))
         (xs (simulation-values r :spot))
         (fwd (forward market expiry))
         (vol (black-vol market (spot market) tau))
         (lo (reduce #'min xs)) (hi (reduce #'max xs))
         (grid (iter (for k below 400)
                     (fincl::collect-double (+ lo (* k (/ (- hi lo) 399))) into g length 400)
                     (finally (return g))))
         (density (map 'double-vector (lambda (x) (lognormal-density x fwd vol tau)) grid)))
    (values
     (plot-figure
      (panel (histogram r :spot :bins bins :label "simulated")
             (make-layer :reference :value
                         (lambda (style)
                           `(,(line-trace grid density :name (format nil "lognormal, vol ~,3F" vol)
                                                       :style (line-attributes (funcall style) :opacity nil))))
                         :name "lognormal")
             (reference-line fwd :axis :x :name "forward" :color :mean :dash "dot")
             :xlabel "S" :ylabel "density")
      :title (format nil "~A: S(~,2F), ~D paths" (process-name process) horizon n-paths)
      :layout '(:bargap 0))
     (simulation-mean r :spot)
     fwd)))

(define-plot log-returns (process market &key (horizon 1) (n-dates 100) (seed 42) (rng :counter))
  "The per-step log returns of one path above its annualized |return|/sqrt(dt)
and, for a process with a variance state (HESTON), the instantaneous
volatility. Volatility clustering shows up as bursts in the returns that line
up with peaks in the volatility.

  (plot-log-returns (make-heston :xi 0.8d0) mkt)"
  (let* ((dates (path-dates market horizon n-dates))
         (with-variance (member :variance (simulation-state-names process)))
         (r (if with-variance
                (simulate (process market dates :n-paths 1 :seed seed :rng rng :keep (:paths 1))
                  (:state s :spot) (:state v :variance)
                  (:final (:spot s)))
                (simulate (process market dates :n-paths 1 :seed seed :rng rng :keep (:paths 1))
                  (:state s :spot)
                  (:final (:spot s)))))
         (all-dates (simulation-dates r))
         (labels (map 'vector #'date-label all-dates))
         (step-labels (subseq labels 1))
         (spots (simulation-path-state r 0 :spot))
         (dts (iter (for (d0 d1) in-intervals (coerce all-dates 'vector))
                    (collect (/ (- (fincl::date-serial d1) (fincl::date-serial d0)) 365d0))))
         (returns (iter (for j from 1 below (length spots))
                        (collect (log (/ (aref spots j) (aref spots (1- j)))))))
         (scaled (mapcar (lambda (ret dt) (/ (abs ret) (sqrt dt))) returns dts)))
    (plot-figure
     (grid (panel (line-layer :statistic step-labels returns "log return") :ylabel "log return")
           (apply #'panel (line-layer :paths step-labels scaled "|r| / sqrt(dt)")
                  `(,@(when with-variance
                        `(,(line-layer :reference labels
                                       (map 'double-vector (lambda (v) (sqrt (max 0d0 v)))
                                            (simulation-path-state r 0 :variance))
                                       "instantaneous vol")))
                    :xlabel "date" :ylabel "annualized vol"))
           :columns 1 :shared-x t)
     :title (format nil "~A: one path, ~D steps" (process-name process) n-dates))))
